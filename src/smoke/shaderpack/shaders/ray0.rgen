#version 460 core
#extension GL_EXT_ray_tracing : require
#ifdef VULKANITE_LIGHT_BVH_PROBE
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "/light_bvh.glsl"
#endif

layout(set = 0, binding = 1) uniform accelerationStructureEXT scene;
layout(set = 3, binding = 0, std430) buffer TraceResults {
    uint hits[2];
    uint lightCount;
    uint lightCheck;
};
layout(location = 0) rayPayloadEXT uint result;

void main() {
    uint ray = gl_LaunchIDEXT.x;
    vec3 origin = vec3(ray == 0u ? 0.5 : 4096.5, 96.0, 0.5);
    traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 0xff, 0, 0, 0,
            origin, 0.01, vec3(0.0, -1.0, 0.0), 128.0, 0);
    hits[ray] = result;
    #ifdef VULKANITE_LIGHT_BVH_PROBE
    if (ray == 0u) {
        lightCount = vltTerrainLightCount();
        lightCheck = 1u;
        vec3 point = vec3(0.375, 11.125, 0.625);
        for (int i = 0; i < 16; i++) {
            VltLightSample light;
            vec3 randoms = fract(vec3(0.618034, 0.371319, 0.825121) * (float(i) + 0.5));
            bool found = vltSampleTerrainLight(point, randoms, light);
            if (lightCount == 0u) {
                if (found) lightCheck = 0u;
            } else if (!found) {
                lightCheck = 0u;
            } else {
                float reverse = vltTerrainLightPdf(point, light.position, light.geometry, light.primitive);
                if (!(reverse > 0.0) || abs(reverse - light.pdf) > 0.03 * light.pdf) lightCheck = 0u;
            }
        }
    }
    #endif
}
